# Project-1-Student Details(Kaggle)
import pandas as pd

student_details = pd.read_csv(r"C:\Users\nasira\Desktop\Student Details-Project 1.csv")
print(student_details)



# print(student_details.columns.tolist())
                    #  Pivot


# ===========================================
# STUDENT PERFORMANCE ANALYSIS PROJECT
# ===========================================

# Import Libraries

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# ===========================================
# Load Dataset
# ===========================================



# ===========================================
# Display Dataset
# ===========================================

print("First 5 Rows")
print(student_details.head())

print("\nLast 5 Rows")
print(student_details.tail())

# ===========================================
# Shape
# ===========================================

print("\nShape of Dataset")
print(student_details.shape)

# ===========================================
# Column Names
# ===========================================

print("\nColumn Names")
# print(student_details.columns.tolist())

# ===========================================
# Dataset Information
# ===========================================

print("\nDataset Information")
print(student_details.info())

# ===========================================
# Statistical Summary
# ===========================================

print("\nStatistical Summary")
print(student_details.describe())

# ===========================================
# Missing Values
# ===========================================

print("\nMissing Values")
print(student_details.isnull().sum())

# ===========================================
# Duplicate Values
# ===========================================

print("\nDuplicate Records")
print(student_details.duplicated().sum())

# ===========================================
# Remove Duplicate Records
# ===========================================

student_details = student_details.drop_duplicates()

print("\nAfter Removing Duplicates")
print(student_details.shape)

# ===========================================
# Check Data Types
# ===========================================

print("\nData Types")
print(student_details.dtypes)

# ===========================================
# Gender Count
# ===========================================

print("\nGender Count")
print(student_details["gender"].value_counts())

# ===========================================
# Performance Category Count
# ===========================================

print("\nPerformance Category")
print(student_details["performance_category"].value_counts())

# ===========================================
# Student Grade Count
# ===========================================

print("\nStudent Grade")
print(student_details["Student Grade"].value_counts())

# ===========================================
# Mental State Count
# ===========================================

print("\nMental State")
print(student_details["mental_state"].value_counts())

# ===========================================
# Internet Quality
# ===========================================

print("\nInternet Quality")
print(student_details["internet_quality"].value_counts())

# ===========================================
# Learning Style
# ===========================================

print("\nLearning Style")
print(student_details["learning_style"].value_counts())

# ===========================================
# Career Goal
# ===========================================

print("\nCareer Goal")
print(student_details["career_goal"].value_counts())

# ===========================================
# Average Final Exam Score
# ===========================================

print("\nAverage Final Exam Score")
print(student_details["final_exam_score"].mean())

# ===========================================
# Highest Final Exam Score
# ===========================================

print("\nHighest Final Exam Score")
print(student_details["final_exam_score"].max())

# ===========================================
# Lowest Final Exam Score
# ===========================================

print("\nLowest Final Exam Score")
print(student_details["final_exam_score"].min())

# ===========================================
# Top 10 Students
# ===========================================

top_students = student_details.sort_values(
    by="final_exam_score",
    ascending=False
)

print("\nTop 10 Students")
print(top_students.head(10))

# ===========================================
# Bottom 10 Students
# ===========================================

low_students = student_details.sort_values(
    by="final_exam_score"
)

print("\nBottom 10 Students")
print(low_students.head(10))


# 1. Gender Wise Student Count
gender_count = student_details.groupby(["gender"]).size()

print(gender_count)

# 2. Student Grade Wise Count
student_grade = student_details.groupby(["Student Grade"]).size()

print(student_grade)


# 3. Performance Category Wise Count
performance = student_details.groupby(["performance_category"]).size()

print(performance)

# 4. Gender & Performance Category
gender_performance = student_details.groupby(
    ["gender", "performance_category"]
).size()

print(gender_performance)

# 5. Learning Style & Career Goal
learning_career = student_details.groupby(
    ["learning_style", "career_goal"]
).size()

print(learning_career)

# 6. Mental State & Student Grade
mental_grade = student_details.groupby(
    ["mental_state", "Student Grade"]
).size()

print(mental_grade)

# 7. Internet Quality & Performance
internet_performance = student_details.groupby(
    ["internet_quality", "performance_category"]
).size()

print(internet_performance)

# 8. Health Condition & Performance
health_performance = student_details.groupby(
    ["Health Condition", "performance_category"]
).size()

print(health_performance)

# 9. Family Support & Student Grade
family_grade = student_details.groupby(
    ["family_support", "Student Grade"]
).size()

print(family_grade)

# 10. Burnout Risk & Mental State
burnout = student_details.groupby(
    ["burnout_risk", "mental_state"]
).size()

print(burnout)

